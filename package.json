{
  "name": "bead-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model circular peyote bead patterns: parse, diagram and (later) 3D.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "render": "tsx src/cli.ts",
    "test": "vitest run",
