    "deploy": "vite build && wrangler deploy",
    "serve:cf": "vite build && wrangler dev --port 8787"
  },
  "dependencies": {
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
