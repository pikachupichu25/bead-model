{
  "name": "bead-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model circular peyote bead patterns: parse, diagram and (later) 3D.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "render": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "vite build && wrangler deploy -c dist/bead_model/wrangler.json",
    "serve:cf": "vite build && vite preview --port 8787 --strictPort",
    "db:migrate": "wrangler d1 migrations apply bead-model --local",
    "db:migrate:remote": "wrangler d1 migrations apply bead-model --remote"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "hono": "^4.13.13",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
